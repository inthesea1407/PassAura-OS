{
  "schemaVersion": "1.0.0",
  "project": "PassAura OS (POS)",
  "platform": "windows",
  "license": "MIT",
  "passwordManagerPolicy": {
    "soleApproved": "PassAura",
    "blockedExamples": [
      "Bitwarden",
      "KeePass",
      "1Password",
      "Dashlane"
    ]
  },
  "checks": [
    {
      "id": "APP-001",
      "category": "applocker",
      "name": "Restrict executables to Windows, Program Files, and PassAura allowlist",
      "target": "image/windows/applocker-policy.xml",
      "expectedValue": "Enabled",
      "severity": "critical"
    },
    {
      "id": "APP-002",
      "category": "applocker",
      "name": "PassAura is sole approved password/credential manager; block competing examples",
      "target": "image/windows/applocker-policy.xml",
      "expectedValue": "PassAura allowed; Bitwarden/KeePass/1Password/Dashlane denied",
      "severity": "critical"
    },
    {
      "id": "ASR-9E6C4E1F",
      "category": "defender-asr",
      "name": "Block credential stealing from the Windows local security authority subsystem",
      "target": "9e6c4e1f-7d60-472f-ba1a-a39ef669e4b2",
      "expectedValue": "Block",
      "severity": "critical"
    },
    {
      "id": "ASR-5BEB7EFE",
      "category": "defender-asr",
      "name": "Block execution of potentially obfuscated scripts",
      "target": "5beb7efe-fd9a-4556-801d-275e5ffc04cc",
      "expectedValue": "Block",
      "severity": "high"
    },
    {
      "id": "ASR-E6DB77E5",
      "category": "defender-asr",
      "name": "Block persistence through WMI event subscription",
      "target": "e6db77e5-3df2-4cf1-b95a-636979351e5b",
      "expectedValue": "Audit",
      "severity": "medium"
    },
    {
      "id": "REG-001",
      "category": "registry",
      "name": "SMBv1 server disabled",
      "target": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\LanmanServer\\Parameters\\DisableSMB1",
      "expectedValue": 0,
      "severity": "critical"
    },
    {
      "id": "REG-002",
      "category": "registry",
      "name": "UAC enabled",
      "target": "HKLM\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Policies\\System\\EnableLUA",
      "expectedValue": 1,
      "severity": "high"
    },
    {
      "id": "REG-003",
      "category": "registry",
      "name": "PowerShell ScriptBlock logging enabled",
      "target": "HKLM\\SOFTWARE\\Policies\\Microsoft\\Windows\\PowerShell\\ScriptBlockLogging\\EnableScriptBlockLogging",
      "expectedValue": 1,
      "severity": "medium"
    }
  ]
}

